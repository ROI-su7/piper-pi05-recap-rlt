# Copy to configs/local.env. Never commit local.env, weights, raw data or credentials.
# The model/task/norm combination must describe the same trained pi0.5 checkpoint.
# PIPER_PYTHON=/absolute/path/to/model-venv/bin/python
# PIPER_ROS_PYTHON=/usr/bin/python3
export PIPER_CONFIG_NAME=pi05_connect_strings
export PIPER_JAX_CHECKPOINT=/absolute/path/to/pi05_checkpoint/30000
export PIPER_NORM_STATS=/absolute/path/to/30000/assets/all_wire_data/norm_stats.json
export PIPER_DEMO_DATASET=/absolute/path/to/all_wire_data
# RLT Stage-1 output from this exact pi0.5 base and three-camera normalization.
export RLINF_STAGE1_RLT_TOKEN=/absolute/path/to/stage1/rlt_token.pt
export PIPER_ROBOT_IP=127.0.0.1
# Original task's optional head-pose feature; use stage2-base to omit it.
# export PIPER_HEADPOSE_WEIGHTS=/absolute/path/to/head_pose_net_v2.pt
# Optional ROS camera workspace whose drivers are already installed:
# export PIPER_CAMERA_WS=/absolute/path/to/camera_ws
# RECAP per-round values; use a new immutable rollout snapshot for each round.
# export RECAP_DATASET=/absolute/path/to/round_001/lerobot
# export RECAP_RUN_DIR=/absolute/path/to/runs/recap/round_001
# export RECAP_VALUE_CHECKPOINT=/absolute/path/to/value/checkpoint
