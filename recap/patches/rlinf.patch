+def _flag(value) -> bool:
+    """Unwrap a LeRobot bool feature stored as a scalar or one-element list."""
+    flag = np.asarray(value)
+    if flag.size != 1 or flag.reshape(-1)[0] not in (True, False, 0, 1):
+        raise ValueError(f"Invalid boolean flag: {flag!r}")
+    return bool(flag.reshape(-1)[0])
+
+
+def load_intervention_frames(
+    dataset_path: Path, success_only: bool = True
+) -> set[tuple[int, int]]:
+    """Return (episode_index, frame_index) keys of human-controlled frames.
+
+    Reads only the small ``intervention``/``is_success`` columns. With
+    ``success_only``, keeps frames from episodes whose terminal frame is
+    successful (Evo-RL); otherwise keeps every correction (pi*0.6).
+    """
+    import pyarrow.parquet as pq
+
+    human: dict[int, list[int]] = {}
+    terminal: dict[int, tuple[int, bool]] = {}
+    for pq_file in sorted((Path(dataset_path) / "data").rglob("*.parquet")):
+        available = set(pq.ParquetFile(pq_file).schema_arrow.names)
+        if "intervention" not in available:
+            return set()
+        columns = ["episode_index", "frame_index", "intervention"]
+        if success_only:
+            if "is_success" not in available:
+                raise ValueError(
+                    f"{pq_file} has no is_success column; cannot select successful "
+                    "interventions."
+                )
+            columns.append("is_success")
+        table = pq.read_table(pq_file, columns=columns).to_pydict()
+        for i, (ep, fr) in enumerate(
+            zip(table["episode_index"], table["frame_index"], strict=True)
+        ):
+            ep, fr = int(ep), int(fr)
+            if _flag(table["intervention"][i]):
+                human.setdefault(ep, []).append(fr)
+            if success_only and fr >= terminal.get(ep, (-1, False))[0]:
+                terminal[ep] = (fr, _flag(table["is_success"][i]))
+    return {
+        (ep, fr)
+        for ep, frames in human.items()
+        if not success_only or terminal[ep][1]
+        for fr in frames
+    }
+
+
